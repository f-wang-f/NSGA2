                    'learn_rate': learn_rate,
                    'opt_type': opt_type
                },
                'test_predictions': {'true': all_test_targets, 'pred': all_test_outputs}
            }, f)

        # 生成报告（带 run_id 前缀）
        report_metrics = generate_comprehensive_report(
